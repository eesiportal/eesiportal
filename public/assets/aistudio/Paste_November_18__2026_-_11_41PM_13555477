<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#060e1f">
<title>EESI Elevators</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:ital,wght@0,400;0,600;0,700;1,400&family=Dancing+Script:wght@500;700&family=Inter:wght@300;400;500;600;700;800&family=Montserrat:ital,wght@0,400;0,600;0,700;1,400&family=Orbitron:wght@400;500;700;900&family=Pacifico&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Poppins:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Rajdhani:wght@400;500;600;700&family=Roboto+Mono:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20356%20196%22%3E%3Cpolygon%20points%3D%2210%2C58%20178%2C14%20346%2C58%22%20fill%3D%22%231e6cf2%22%20stroke%3D%22%23111%22%20stroke-width%3D%228%22%2F%3E%3Crect%20x%3D%223%22%20y%3D%2258%22%20width%3D%22350%22%20height%3D%22134%22%20fill%3D%22%23ffe500%22%20stroke%3D%22%23111%22%20stroke-width%3D%228%22%2F%3E%3Cg%20fill%3D%22%231e6cf2%22%3E%3Crect%20x%3D%2211%22%20y%3D%2266%22%20width%3D%2276.75%22%20height%3D%22118%22%2F%3E%3Crect%20x%3D%2296.75%22%20y%3D%2266%22%20width%3D%2276.75%22%20height%3D%22118%22%2F%3E%3Crect%20x%3D%22182.5%22%20y%3D%2266%22%20width%3D%2276.75%22%20height%3D%22118%22%2F%3E%3Crect%20x%3D%22268.25%22%20y%3D%2266%22%20width%3D%2276.75%22%20height%3D%22118%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22%23fff%22%20font-family%3D%22Arial%20Black%2CArial%2Csans-serif%22%20font-weight%3D%22900%22%20font-size%3D%22104%22%20text-anchor%3D%22middle%22%3E%3Ctext%20x%3D%2249.4%22%20y%3D%22160%22%3EE%3C%2Ftext%3E%3Ctext%20x%3D%22135.1%22%20y%3D%22160%22%3EE%3C%2Ftext%3E%3Ctext%20x%3D%22220.9%22%20y%3D%22160%22%3ES%3C%2Ftext%3E%3Ctext%20x%3D%22306.6%22%20y%3D%22160%22%3EI%3C%2Ftext%3E%3C%2Fg%3E%3C%2Fsvg%3E">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
<link rel="manifest" href="./manifest.webmanifest">
<link rel="apple-touch-icon" href="./icons/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="EESI Ops">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  --cyan:#2f8cff;
  --pink:#5aa9ff;
  --violet:#1e6cf2;
  --gold:#f5a623;
  --ember:#f59e0b;
  --void:#060e1f;
  --void-2:#0a1730;
  --panel:rgba(12,27,56,.92);
  --panel-2:rgba(9,21,44,.96);
  --border:rgba(47,140,255,.28);
  --border-hot:rgba(47,140,255,.7);
  --text:#e8f0ff;
  --muted:#8ea6cc;
  --red:#ef4444;
  --green:#22c55e;
  --amber:#f5a623;
  --blue:#2f8cff;
  --navy:#0a1a36;
  --sh:0 4px 14px rgba(0,0,0,.35);
}
*{box-sizing:border-box}
html,body{height:100%;overflow-x:hidden;-webkit-tap-highlight-color:transparent;overscroll-behavior:none;scroll-behavior:smooth;max-width:100vw}
body{
  margin:0;
  padding-top:env(safe-area-inset-top);
  padding-bottom:calc(70px + env(safe-area-inset-bottom));
  min-height:100dvh;
  color:var(--text);
  font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
  font-size:15px;
  font-weight:500;
  position:relative;
  isolation:isolate;
  --deco-icon:"✨";
  background:linear-gradient(180deg,#0a1426 0%,#050b18 100%)!important;
}
.hidden{display:none!important}
.muted{color:var(--muted);font-size:13px}
.tap{cursor:pointer;display:inline-block;flex:0 0 auto}
h1,h2,h3,.title{font-weight:700;text-transform:uppercase;color:#fff}
.title{font-size:22px;margin:0 0 16px;position:relative;display:inline-block}
img,video,canvas,iframe{max-width:100%}

header{
  position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:10px;padding:12px 14px;
  background:linear-gradient(180deg,#0f2448 0%,#0b1b38 100%);
  border-bottom:1px solid rgba(47,140,255,.25);
  backdrop-filter:blur(20px) saturate(160%);-webkit-backdrop-filter:blur(20px) saturate(160%);
}
.brand,.brand-long{white-space:nowrap;font-size:14px;overflow:visible;color:#fff}
.brand{flex:1;font-weight:700}
.brand-long{display:inline}
.hdr-logo{display:block;height:34px;width:auto;flex:none;overflow:visible}
.logo-wrap{position:relative;display:inline-block;flex:none;line-height:0}
.logo-deco{position:absolute;top:-14px;right:-12px;font-size:16px;line-height:1;transform:rotate(16deg);pointer-events:none;filter:drop-shadow(0 2px 3px rgba(0,0,0,.35))}
.auth-logo{width:88px;height:50px;flex:none;display:block}
.auth-logo .logo-wrap{display:block;width:100%;height:100%}
.auth-logo svg{width:100%;height:100%;overflow:visible}
.auth-logo .logo-deco{font-size:22px;top:-18px;right:-16px}
.hbtn{border-radius:10px;padding:8px 10px;font-size:13px;min-width:auto;min-height:38px;position:relative;overflow:visible}
.live-dot{width:10px;height:10px;border-radius:50%;background:var(--amber);flex:none;display:inline-block;animation:pulseDot 2s ease-in-out infinite}
.live-dot[data-live="1"]{background:var(--green)}
.live-dot[data-live="0"]{background:var(--red)}
@keyframes pulseDot{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.25);opacity:.7}}

.ticker{overflow:hidden;white-space:nowrap;padding:8px 10px;font-size:12px;background:#0b1b38;color:#cfe0ff;border-bottom:1px solid rgba(47,140,255,.2)}
.ticker span{display:inline-block;padding-left:100%;animation:marquee 40s linear infinite;will-change:transform;color:#cfe0ff}
@keyframes marquee{to{transform:translateX(-100%)}}

main{max-width:860px;margin:auto;position:relative}
.ct{padding:16px}
.card,.item,.stat,.tile,.person,table{
  background:linear-gradient(180deg,rgba(14,30,62,.95),rgba(9,21,44,.95));
  border:1px solid rgba(47,140,255,.22);
  border-radius:14px;
  box-shadow:var(--sh);
  position:relative;
  transition:border-color .25s,box-shadow .25s;
}
.card:hover,.item:hover,.person:hover,.tile:hover,.stat:hover{border-color:rgba(47,140,255,.5);box-shadow:0 6px 20px rgba(30,108,242,.18)}
.card{padding:16px;margin-bottom:14px}
.item{padding:14px;margin-bottom:10px}
.item.unread-notice{border-left:4px solid var(--cyan);box-shadow:0 0 18px rgba(47,140,255,.32)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stat,.tile{padding:14px 10px;text-align:center;cursor:pointer;position:relative;overflow:hidden}
.stat strong{display:block;font-size:24px;color:#2f8cff;font-weight:800}
.stat span{font-size:12px;display:block;margin-top:4px;color:#8ea6cc}
.tile{font-weight:600;font-size:13px;padding:14px 8px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:#e8f0ff}
.tile .ic{display:block;font-size:22px}
.stat:active,.tile:active{transform:scale(.96)}

/* Big Local Time & Weather (no title) */
#liveInfoCard{text-align:center;padding:20px 16px}
#liveClock{font-size:clamp(22px,5vw,32px);font-weight:800;line-height:1.25;color:#e8f0ff}
#liveWeather{font-size:clamp(18px,3.8vw,24px);font-weight:700;margin-top:8px;color:#2f8cff}

/* Buttons with Shadow & Daily/Session Decoration */
button{
  cursor:pointer;position:relative;overflow:hidden;min-height:42px;min-width:42px;padding:10px 14px;
  border-radius:10px;box-shadow:0 4px 12px rgba(0,0,0,.45);
  color:#cfe0ff;background:rgba(47,140,255,.08);border:1px solid rgba(47,140,255,.3);
  font-weight:600;transition:transform .18s,box-shadow .22s,background .2s;
}
button:hover:not(:disabled){background:rgba(47,140,255,.16);box-shadow:0 6px 16px rgba(30,108,242,.35);transform:translateY(-1px)}
button:active:not(:disabled){transform:translateY(1px) scale(.97)}
button:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
button:disabled{opacity:.45;cursor:not-allowed}
.btn,.chat-send{background:#1e6cf2;color:#fff;border:1px solid #1e6cf2;font-weight:700;box-shadow:0 4px 14px rgba(30,108,242,.45)}
.btn:hover:not(:disabled){background:#2f7cff;border-color:#2f7cff;box-shadow:0 6px 20px rgba(30,108,242,.6)}
.red{background:rgba(239,68,68,.14);color:#ff6b6b;border:1px solid rgba(239,68,68,.45);box-shadow:0 4px 12px rgba(239,68,68,.25)}
.green{background:#22c55e;color:#06210f;border:0;box-shadow:0 4px 14px rgba(34,197,94,.4)}
.gray{background:rgba(148,163,184,.12);color:#cfe0ff;border:1px solid rgba(148,163,184,.3);box-shadow:0 3px 10px rgba(0,0,0,.35)}
.small-btn{padding:6px 10px;font-size:11px;min-height:32px;border-radius:8px}
.tab,.filter,.chip{padding:8px 14px;font-size:11px;min-height:38px;background:rgba(12,27,56,.9);color:#8ea6cc;border:1px solid rgba(47,140,255,.2);border-radius:999px;font-weight:600;box-shadow:0 3px 10px rgba(0,0,0,.35)}
.tab.active,.filter.active,.chip.active{background:#1e3f7a;color:#fff;border-color:rgba(47,140,255,.6);box-shadow:0 4px 14px rgba(30,108,242,.45)}
.text-button,.composer-btn,.composer-emoji,.story,.info-row,.thread-row,.msg-context-btn{box-shadow:none}
.text-button:hover:not(:disabled),.composer-btn:hover:not(:disabled),.story:hover:not(:disabled),.info-row:hover:not(:disabled){box-shadow:none;transform:none}

body:not(.no-decor) button:not(.text-button):not(.composer-btn):not(.composer-emoji):not(.story):not(.info-row):not(.thread-row):not(.msg-context-btn):not(.report-att-del):not(.msgr-icon){padding-right:22px}
body:not(.no-decor) .seg button{padding-right:16px!important}
body:not(.no-decor) nav.bottom button{padding-right:0}
body:not(.no-decor) button:not(.text-button):not(.composer-btn):not(.composer-emoji):not(.story):not(.info-row):not(.thread-row):not(.msg-context-btn):not(.report-att-del)::after{
  content:var(--deco-icon);position:absolute;top:3px;right:5px;font-size:10px;line-height:1;opacity:.85;pointer-events:none;filter:drop-shadow(0 1px 2px rgba(0,0,0,.35));
}
body:not(.no-decor) nav.bottom button:not(.active)::after{opacity:.45;top:4px;right:8px;font-size:9px}
body:not(.no-decor) nav.bottom button.active::after{opacity:.95;top:4px;right:8px;font-size:10px}
body:not(.no-decor) .msgr-icon::after{top:2px;right:2px;font-size:9px}
body.no-decor button::after{content:none!important}

.badge,.badge-role{display:inline-block;padding:2px 8px;border-radius:999px;font-size:11px;margin-left:6px;background:rgba(47,140,255,.1);border:1px solid rgba(47,140,255,.5);color:#7fb8ff}
.field{margin-bottom:12px;position:relative}
label{display:block;margin-bottom:6px;color:#8ea6cc;text-transform:uppercase;font-size:11px;font-weight:600}
input,select,textarea{width:100%;padding:11px 12px;font-size:16px!important;font-weight:500;touch-action:manipulation;transition:border-color .2s,box-shadow .22s;background:rgba(6,14,31,.8);color:#e8f0ff;border:1px solid rgba(47,140,255,.25);border-radius:10px}
input:focus,select:focus,textarea:focus{outline:none;border-color:#2f8cff;box-shadow:0 0 0 3px rgba(47,140,255,.18)}
textarea{resize:vertical;min-height:80px}
.check-row{display:flex;gap:8px;align-items:center;padding:8px 0}
.check-row input{width:auto}
.tabs,.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}

nav.bottom{position:fixed;bottom:0;left:0;right:0;height:calc(68px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);display:flex;z-index:30;backdrop-filter:blur(22px) saturate(150%);-webkit-backdrop-filter:blur(22px) saturate(150%);background:linear-gradient(180deg,#0c1d3d,#081429);border-top:1px solid rgba(47,140,255,.25)}
nav.bottom button{flex:1;min-height:68px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;position:relative;background:transparent;border:0;border-radius:0;box-shadow:none;color:#7d93b8;font-size:11px;font-weight:600}
nav.bottom button:hover:not(:disabled){background:transparent;box-shadow:none;transform:none}
nav.bottom button span{font-size:22px}
nav.bottom button.active{color:#fff;background:rgba(30,108,242,.35);border-radius:999px}
nav.bottom button.active::before{content:"";position:absolute;top:6px;width:30px;height:3px;border-radius:0 0 3px 3px;background:#2f8cff}
@supports(padding:max(0px)){nav.bottom{padding-bottom:max(6px,env(safe-area-inset-bottom))}}

.person{display:flex;align-items:center;gap:12px;width:100%;padding:12px;margin:6px 0;text-align:left}
.avatar{width:44px;height:44px;flex:0 0 44px;border-radius:50%;object-fit:cover;background:#1e6cf2;color:#fff;border:2px solid rgba(47,140,255,.6);font-weight:700}
.initial{display:grid;place-items:center;font-weight:900;font-size:16px}
.person-info{flex:1;min-width:0}
.person-info b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px;font-weight:700}
.person-group-title{font-size:11px;font-weight:800;color:var(--gold);text-transform:uppercase;margin:12px 0 6px;border-bottom:1px dashed rgba(255,215,0,.25);padding-bottom:4px}

.cover{height:150px;display:grid;place-items:center;background:linear-gradient(135deg,var(--violet) 0%,var(--pink) 50%,var(--cyan) 100%);background-size:cover;background-position:center;border-radius:14px;color:#fff;overflow:hidden;position:relative}
.photo-row{display:flex;gap:12px;align-items:center;position:relative;margin:-40px 10px 0}
.photo{width:88px;height:88px;border-radius:50%;object-fit:cover;background:var(--panel);border:2px solid rgba(47,140,255,.4)}
.photo-fields{flex:1;padding-top:40px}
.map{width:100%;height:320px;border:0;border-radius:10px}

table{width:100%;border-collapse:collapse;overflow:hidden}
th,td{padding:9px 8px;border:1px solid rgba(47,140,255,.18);text-align:left;font-size:13px}
th{background:rgba(47,140,255,.08);color:#8ea6cc;text-transform:uppercase;font-size:11px;font-weight:600}
td{color:#e8f0ff}
.dtr-tabs{display:flex;gap:8px;margin:0 0 12px}
.dtr-paper{background:#fff;color:#000;border:0;padding:8px;width:100%;max-width:1000px;aspect-ratio:17/11;margin:0 auto 12px;overflow:auto;border-radius:4px;box-shadow:0 12px 40px rgba(0,0,0,.45)}
.dp-table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:11px;font-weight:700;background:#fff!important;border-radius:0!important;box-shadow:none!important;border:1px solid #000!important}
.dp-table th,.dp-table td{border:1px solid #000!important;padding:4px 3px;text-align:center;overflow-wrap:anywhere;color:#000!important;background:#fff!important}
.dp-table .dp-sheet-title{font-size:19px!important;line-height:1.2;font-style:normal;padding:5px}
.dp-col-head th{font-style:italic;font-size:11px!important}
.dp-empty{padding:14px!important;font-weight:400}
.dp-employee-sign{width:34%;min-width:210px;text-align:center;margin-top:4px;color:#000}
.dp-employee-sign img{display:block;width:180px;height:65px;object-fit:contain;margin:0 auto;border:0}
.dp-employee-name{font-weight:bold;font-size:13px;margin-top:2px;padding-bottom:4px;border-bottom:3px double #000;color:#000}
.dp-employee-caption{font-weight:bold;font-style:italic;font-size:11px;margin-top:4px;color:#000}
.dtr-actions{display:flex;gap:8px;max-width:1000px;margin:0 auto}
.dtr-actions button{flex:1;white-space:normal}
.dtr-sign{background:#fff;border-radius:6px;border:1px solid var(--border);max-width:100%}
.person-picker{max-height:180px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:10px;background:rgba(4,8,24,.7)}

.chat-page .chat-ct{display:flex;flex-direction:column;height:calc(100dvh - 158px);padding:8px 14px 0}
#chatBrowser,#chatCompose,#activeChat,#chatInfo{display:flex;flex-direction:column;flex:1;min-height:0}
.msgr-head{display:flex;align-items:center;gap:10px;margin:0 0 12px;flex:none}
.msgr-title{font-size:26px;font-weight:800;margin:0;flex:1;color:#fff}
.msgr-icon{width:40px;height:40px;border-radius:50%;font-size:16px;display:grid;place-items:center;flex:none;padding:0;background:rgba(47,140,255,.1);color:#7fb8ff;border:1px solid rgba(47,140,255,.3);box-shadow:0 3px 10px rgba(0,0,0,.4)}
.msgr-search,.composer-input{display:flex;align-items:center;background:rgba(6,14,31,.85);border:1px solid rgba(47,140,255,.22);border-radius:999px}
.msgr-search{gap:9px;padding:10px 16px;margin-bottom:12px;flex:none}
.msgr-search input{border:0;background:transparent;padding:0;flex:1;font-size:15px;outline:none;width:auto;box-shadow:none}
.msgr-search span{opacity:.6;font-size:14px}
.msgr-stories{display:flex;gap:14px;overflow-x:auto;padding:2px 0 12px;flex:none;scrollbar-width:none}
.msgr-stories::-webkit-scrollbar{display:none}
.story{flex:0 0 auto;width:70px;text-align:center;background:none;border:0;padding:0}
.story .bubble-av{position:relative;width:60px;height:60px;margin:0 auto 6px;border-radius:50%;border:2px solid var(--cyan);display:grid;place-items:center;font-size:22px}
.story .bubble-av .avatar{width:100%;height:100%;border:0}
.story small{display:block;font-size:11px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600}
.story .presdot{position:absolute;right:2px;bottom:2px;width:14px;height:14px;border-radius:50%;background:var(--green);border:2px solid var(--void);animation:pulseDot 2s infinite}
.msgr-chips{display:flex;gap:8px;overflow-x:auto;margin:0 0 4px;padding-bottom:6px;flex:none;scrollbar-width:none}
.msgr-chips::-webkit-scrollbar{display:none}
.msgr-list{flex:1;min-height:0;overflow:auto;margin-top:4px}
.thread-row{display:flex;gap:12px;align-items:center;width:100%;padding:10px 8px;background:none;border:0;border-radius:10px;text-align:left}
.thread-row:active{background:rgba(47,140,255,.1)}
.thread-av{position:relative;flex:0 0 54px;display:block}
.thread-av .avatar{width:54px;height:54px;font-size:21px}
.thread-av .online-dot{position:absolute;right:0;bottom:0;width:14px;height:14px;border:2px solid var(--void);border-radius:50%;background:var(--green)}
.thread-txt{flex:1;min-width:0}
.thread-top{display:flex;align-items:baseline;gap:8px}
.thread-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:15px;font-weight:500}
.thread-row.is-unread .thread-name{font-weight:800}
.thread-time{color:var(--muted);flex:none;font-size:10px}
.thread-sub{display:flex;align-items:center;gap:6px;margin-top:2px}
.thread-preview{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;color:var(--muted)}
.thread-row.is-unread .thread-preview{font-weight:600}
.msgr-dot{width:10px;height:10px;border-radius:50%;background:var(--cyan);flex:none}

.chat-head{display:flex;align-items:center;gap:8px;padding:0 0 10px;border-bottom:1px solid var(--border);margin-bottom:8px;flex:none}
.chat-head .thread-av{flex:0 0 38px}
.chat-head .thread-av .avatar{width:38px;height:38px;font-size:15px}
.chat-head b{display:block;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:700}
.chat-head small{color:var(--muted);font-size:12px}
.msgr-msgs{flex:1;min-height:0;overflow:auto;padding:4px 0 6px}
.msgr-row{display:flex;gap:8px;align-items:flex-end;margin:2px 0 16px;animation:msgIn .24s ease-out}
@keyframes msgIn{from{opacity:0;transform:translateY(8px) scale(.97)}to{opacity:1;transform:none}}
.msgr-row.mine{flex-direction:row-reverse}
.msgr-row .avatar{width:30px;height:30px;font-size:13px;flex:0 0 30px}
.msgr-bub{max-width:76%;padding:10px 14px;border-radius:14px;font-size:15px;line-height:1.4;overflow-wrap:anywhere;position:relative;cursor:pointer;background:rgba(14,30,62,.95);border:1px solid rgba(47,140,255,.22);color:#e8f0ff}
.msgr-row.mine .msgr-bub{background:#1e6cf2;color:#fff;border:0}
.msgr-time{display:block;font-size:10px;opacity:.7;margin-top:3px;text-align:right}
.chat-img{max-width:220px;border-radius:10px;display:block;margin-top:6px;border:1px solid var(--border)}
.chat-plus{display:flex;flex-direction:column;gap:2px;background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:6px;margin:0 0 6px;flex:none}
.chat-plus button{background:none;border:0;box-shadow:none;text-align:left;padding:10px 12px;border-radius:6px;font-size:14px}
.emoji-pop{display:flex;flex-wrap:wrap;gap:6px;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:10px;margin:0 0 6px;font-size:22px;flex:none}
.emoji-pop span{cursor:pointer;padding:2px;border-radius:6px}
.chat-composer{display:flex;align-items:center;gap:6px;padding:8px 0 4px;flex:none}
.composer-btn{width:36px;height:36px;border-radius:50%;border:0;background:none;font-size:20px;display:grid;place-items:center;flex:none;padding:0}
.composer-input{flex:1;padding:0 4px 0 14px}
.composer-input input{flex:1;border:0;background:transparent;padding:10px 0;border-radius:0;font-size:15px;box-shadow:none}
.composer-emoji{border:0;background:none;font-size:19px;padding:4px}
.chat-send{width:44px;height:44px;border-radius:50%;border:0;font-size:18px;flex:none;padding:0}
.reply-header{font-size:12px;opacity:.85;margin-bottom:6px;display:flex;align-items:center;gap:4px;font-weight:600;border-left:2px solid currentColor;padding-left:6px}
.msg-reaction-badge{position:absolute;bottom:-12px;right:8px;background:var(--panel-2);border:1px solid var(--border-hot);border-radius:12px;padding:2px 8px;font-size:13px;display:flex;align-items:center;gap:2px;z-index:10;cursor:pointer;color:var(--text)}
.pin-above{font-size:11px;font-weight:700;color:var(--gold);padding:0 40px;margin:0 0 4px;display:flex}
.pin-above.mine{justify-content:flex-end}

#messageContextMenu{position:fixed;z-index:9999;background:var(--panel-2);border:1px solid var(--border-hot);border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.6);display:flex;flex-direction:column;overflow:hidden;width:172px;backdrop-filter:blur(16px)}
.msg-reactions{display:flex;justify-content:space-between;padding:8px 10px;border-bottom:1px solid var(--border);background:rgba(47,140,255,.08)}
.msg-reactions span{font-size:20px;cursor:pointer;padding:2px;border-radius:50%}
.msg-context-btn{display:flex;align-items:center;gap:8px;padding:10px 14px;background:none;border:0;border-bottom:1px solid rgba(47,140,255,.15);border-radius:0;text-align:left;font-size:14px;cursor:pointer;min-height:38px}
.msg-context-btn:last-child{border-bottom:0}

.toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%);z-index:100;padding:14px 22px;max-width:90vw;text-align:center;font-weight:700;font-size:14px;animation:toastIn .32s ease-out;background:#0f2448;color:#fff;border:1px solid rgba(47,140,255,.5);border-radius:10px}
@keyframes toastIn{from{transform:translateX(-50%) translateY(28px) scale(.9);opacity:0}to{transform:translateX(-50%) translateY(0) scale(1);opacity:1}}

.dialog{position:fixed;inset:0;z-index:90;display:grid;place-items:center;padding:20px;background:rgba(2,3,10,.8);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.dialog .card{width:min(440px,100%);animation:dialogPop .3s ease-out}
@keyframes dialogPop{from{transform:scale(.88) translateY(14px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}

.sheet-back{position:fixed;inset:0;background:rgba(2,3,10,.82);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:80;display:flex;align-items:flex-end;justify-content:center}
.sheet{width:100%;max-width:540px;max-height:88vh;overflow:auto;padding:20px 16px calc(20px + env(safe-area-inset-bottom));animation:sheetSlide .34s ease-out;position:relative;background:#0b1b38;color:#e8f0ff;border:1px solid rgba(47,140,255,.3);border-radius:18px 18px 0 0}
.sheet::before{content:"";display:block;width:48px;height:4px;border-radius:4px;margin:-6px auto 16px;background:#2f8cff}
@keyframes sheetSlide{from{transform:translateY(100%)}to{transform:translateY(0)}}
.sheet h2{margin:8px 0 8px;font-size:20px}
.sheet-text{line-height:1.55;white-space:pre-wrap}
.big-av{width:96px;height:96px;border-radius:50%;object-fit:cover;display:block;margin:0 auto;border:2px solid var(--cyan)}
.big-init{display:grid;place-items:center;background:#1e6cf2;color:#fff;font-weight:900;font-size:36px}
.info-head{text-align:center;padding:10px 0 14px}
.info-head h2{margin:10px 0 2px;font-size:20px}
.info-section{margin:14px 0}
.info-label{font-size:11px;color:var(--cyan);font-weight:700;margin:0 0 6px;text-transform:uppercase}
.info-row{display:flex;gap:12px;align-items:center;width:100%;padding:12px 6px;background:none;border:0;border-bottom:1px dashed rgba(47,140,255,.2);border-radius:0;text-align:left;font-weight:500;font-size:14px}
.info-row.danger{color:var(--red)}
.info-ic{width:26px;text-align:center;flex:0 0 26px;font-size:16px}
.info-txt{display:flex;flex-direction:column;min-width:0}
.media-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:8px}
.media-grid img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:6px;border:1px solid var(--border);cursor:pointer}
.member-strip{display:flex;gap:8px;overflow-x:auto;padding:4px 0 8px}
.mini-av{flex:0 0 auto}
.mini-av .avatar{width:48px;height:48px;flex:0 0 48px}
.media-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px dashed rgba(47,140,255,.15)}
.media-item img{width:56px;height:56px;object-fit:cover;border-radius:6px;border:1px solid var(--border)}
.media-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pv-row{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px dashed rgba(47,140,255,.15)}
.pv-row span:last-child{text-align:right;overflow-wrap:anywhere}

.call-screen{position:fixed;inset:0;z-index:200;background:radial-gradient(ellipse at center,#0d1740 0%,#02030a 100%);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:24px 16px calc(24px + env(safe-area-inset-bottom));overflow:hidden}
.call-screen video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#000}
.call-screen.audio #callRemote{opacity:0;pointer-events:none}
#callLocal{position:absolute;right:12px;top:72px;width:110px;height:150px;object-fit:cover;border-radius:10px;border:2px solid var(--cyan);z-index:1}
.call-top,.call-controls{position:relative;z-index:2;text-align:center}
.call-top{display:flex;flex-direction:column;align-items:center;gap:6px}
.call-top b{font-size:22px;text-shadow:0 1px 4px #000}
.call-top small{opacity:.9;text-shadow:0 1px 4px #000}
.call-top .big-av{width:130px;height:130px}
.call-controls{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}
.call-controls button{border:0;border-radius:999px;padding:14px 22px;background:rgba(255,255,255,.18);color:#fff;font-weight:800;min-width:100px;backdrop-filter:blur(12px)}
.call-controls .call-end,.call-controls .call-decline{background:linear-gradient(135deg,#ff3366,#b91c40)}
.call-controls .call-accept{background:linear-gradient(135deg,#00ffa3,#00b374);color:#021a11}

.auth-screen{position:fixed;inset:0;z-index:300;display:grid;place-items:center;padding:24px 18px;overflow:auto;background:radial-gradient(900px 480px at 50% -12%,#1a2050 0%,#0d1229 55%,#02030a 100%)}
.auth-wrap{width:100%;max-width:420px;margin:auto;position:relative;z-index:1}
.auth-brand{display:flex;align-items:center;gap:12px;margin:0 0 20px;color:#fff}
.auth-brand-name{font-size:15px;font-weight:900;color:#fff}
.auth-brand-sub{font-size:12px;color:#9fb0cc;margin-top:3px}
.auth-card{background:linear-gradient(160deg,rgba(10,16,42,.96),rgba(4,8,24,.98));color:#e8f4ff;border-radius:20px;padding:26px;box-shadow:0 0 60px rgba(0,240,255,.25);position:relative}
.auth-card h2{font-size:20px;margin:0 0 6px;font-weight:800}
.auth-card .lede{color:#8fa3c9;font-size:13px;margin:0 0 18px;line-height:1.5}
.auth-card .status{color:#7fb8ff;text-align:center;font-size:13px;margin:16px 0 0;min-height:18px}
.auth-links{display:flex;justify-content:space-between;gap:10px;margin:14px 0 0}
.text-button{background:none;border:none;color:var(--cyan);padding:6px 0;font-size:13px;font-weight:700;min-height:auto;min-width:auto}
.divider{display:flex;align-items:center;gap:10px;margin:20px 0 14px;color:#8fa3c9;font-size:11px;text-transform:uppercase}
.divider::before,.divider::after{content:"";height:1px;flex:1;background:rgba(47,140,255,.35)}
.social-button{display:flex;align-items:center;justify-content:center;gap:10px;font-size:14px;font-weight:700;width:100%;margin-bottom:8px;border-radius:10px;padding:12px}
.social-button svg{width:18px;height:18px;flex:none}
.full{width:100%;margin-top:14px}

.settings-row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px dashed rgba(47,140,255,.2)}
.settings-nav-btn{width:100%;display:flex;justify-content:space-between;align-items:center;text-align:left;margin:6px 0!important;padding:11px 12px!important;font-size:13px!important}
.settings-subpanel{padding:8px 10px 10px;margin:4px 0 8px;border:1px solid var(--border);border-radius:10px;background:rgba(0,0,0,.14)}
#settingsMenu{position:fixed;right:10px;top:60px;z-index:60;width:min(310px,calc(100vw - 20px))!important;max-height:calc(100dvh - 80px);overflow-y:auto;padding:14px;border-radius:12px;background:#0b1b38;color:#e8f0ff;border:1px solid rgba(47,140,255,.3)}
#settingsMenu h2{font-size:17px;margin:0 0 10px}
#settingsMenu h3{font-size:11px;margin:16px 0 8px;text-transform:uppercase;color:var(--cyan)}
#settingsMenu label{margin-bottom:4px;font-size:11px}
#settingsMenu select,#settingsMenu input:not([type="checkbox"]):not([type="file"]){padding:8px;font-size:13px;margin-bottom:8px}
#settingsMenu input[type="checkbox"]{width:auto;margin-right:6px;accent-color:var(--cyan)}
#settingsMenu button{padding:8px 10px;font-size:12px;margin:4px 0}
#settingSoundFile{flex:1;min-width:0}
#clearSoundFileButton{flex:0 0 auto}

#pmsReportContent:not(.hidden){display:block;position:relative;inset:auto;z-index:auto;overflow:visible;background:transparent;padding:0}
#pmsReportContent .ct{max-width:800px;margin:0 auto;padding:0}
#pmsChecklistPanel:not(.hidden){display:block;position:fixed;inset:0;z-index:81;overflow-y:auto;background:var(--void-2);padding:16px}
#pmsChecklistPanel > *{max-width:800px;margin-left:auto;margin-right:auto}
#pmsRecordOverlay:not(.hidden){position:fixed;inset:0;z-index:85;overflow-y:auto;background:rgba(2,3,10,.95);padding:16px;backdrop-filter:blur(8px)}
#pmsRecordOverlay > .card{max-width:800px;margin:0 auto}

.report-att-item{position:relative;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--panel);aspect-ratio:1;display:flex;align-items:center;justify-content:center;padding:4px}
.report-att-item img{width:100%;height:100%;object-fit:cover;border:0;border-radius:6px}
.report-att-file{font-size:11px;text-align:center;word-break:break-word;padding:4px;color:var(--text)}
.report-att-del{position:absolute;top:4px;right:4px;width:24px;height:24px;min-width:24px;min-height:24px;padding:0;border-radius:50%!important;font-size:13px;line-height:1;display:grid;place-items:center;background:rgba(0,0,0,.75)!important;color:#fff!important;border:1px solid rgba(255,255,255,.35)!important;z-index:2}

.site-header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.site-header .title{margin:0}
.site-header .btn,.site-header .gray{flex:0 0 auto}
.page{animation:pageFade .32s ease-out}
@keyframes pageFade{from{opacity:0;transform:translateY(10px) scale(.99)}to{opacity:1;transform:none}}
.page.hidden{animation:none}
.online-dot{width:9px;height:9px;border-radius:50%;background:#5a6480;display:inline-block;margin-right:4px}
.online-dot.on{background:var(--green)}
.warn{background:rgba(245,166,35,.1);color:#fcd34d;border-color:rgba(245,166,35,.4)}
#offlineBanner{position:fixed;top:0;left:0;right:0;background:linear-gradient(120deg,#ef4444,#991b1b);color:white;text-align:center;padding:12px;font-weight:800;font-size:14px;z-index:9999}
::-webkit-scrollbar{width:0;height:0;background:transparent}
*{scrollbar-width:none}
header,nav,.msgr-head,.chat-head,.page>h1.title,.tile,.stat,.chip,.tab,.filter{user-select:none;-webkit-user-select:none}
.msgr-bub,.item,.card p,textarea,input{user-select:text;-webkit-user-select:text}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.inline-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}

section.page:not(#page-chat)>.ct{display:flex;flex-direction:column;min-height:calc(100dvh - 210px)}
section.page:not(#page-chat)>.ct>.deco-band{margin-top:auto}
.deco-band{position:relative;overflow:hidden;margin:16px 0 8px;border-radius:14px;border:1px solid rgba(47,140,255,.28);background:linear-gradient(135deg,var(--dg1),var(--dg2));padding:14px 14px 18px;min-height:150px;display:flex;flex-direction:column;justify-content:center;gap:12px;box-shadow:var(--sh)}
.verse-decor{position:relative;overflow:hidden;border-radius:12px;padding:12px;margin-bottom:14px;background:linear-gradient(135deg,var(--dg1,#0a1a36),var(--dg2,#1e4f9c));border:1px solid rgba(255,255,255,.18);text-align:center}
.deco-ribbon{color:#fff;font-weight:800;text-transform:uppercase;letter-spacing:.14em;font-size:12px;text-align:center;opacity:.92}
.verse-decor .deco-ribbon{margin-bottom:8px}
.deco-icons{display:flex;flex-wrap:wrap;justify-content:center;gap:16px 22px}
.verse-decor .deco-icons{gap:12px 16px}
.deco-icons .d{font-size:30px;line-height:1.1;animation:decoFloat 3.2s ease-in-out infinite alternate;filter:drop-shadow(0 3px 6px rgba(0,0,0,.35))}
.verse-decor .deco-icons .d{font-size:24px}
@keyframes decoFloat{from{transform:translateY(0) rotate(-5deg)}to{transform:translateY(-7px) rotate(5deg)}}
@media(prefers-reduced-motion:reduce){.deco-icons .d{animation:none}}

.live-tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:10px 0}
.seg{display:inline-flex;border:1px solid rgba(47,140,255,.35);border-radius:10px;overflow:hidden;box-shadow:0 3px 10px rgba(0,0,0,.3)}
.seg button{border:0!important;border-radius:0!important;margin:0!important;min-height:34px;box-shadow:none!important}
.seg button.active{background:#1e6cf2!important;color:#fff!important}
#liveMap{height:min(62vh,460px)!important;width:100%;border-radius:8px;z-index:0}

.item.sess-now{border-color:#22c55e!important;box-shadow:0 0 0 1px #22c55e,0 0 22px rgba(34,197,94,.35)!important}
.item.sess-soon{border-color:#f59e0b!important;box-shadow:0 0 0 1px #f59e0b,0 0 18px rgba(245,158,11,.3)!important}
.sess-badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 8px;border-radius:999px;margin-left:6px;color:#04110a;vertical-align:middle}
.sess-badge.now{background:#22c55e;animation:pulseDot 1.6s ease-in-out infinite}
.sess-badge.soon{background:#f59e0b;color:#1f1300}
.pin-dots{display:flex;justify-content:center;gap:10px;margin:14px 0}
.pin-dots span{width:14px;height:14px;border-radius:50%;border:2px solid var(--cyan);background:transparent}
.pin-dots span.on{background:var(--cyan)}
.pin-input{width:100%;text-align:center;font-size:24px;letter-spacing:.5em!important;padding:10px}
.pin-shake{animation:pinShake .4s}
@keyframes pinShake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}

.ptr-banner{position:fixed;left:50%;top:calc(12px + env(safe-area-inset-top));transform:translate(-50%,-90px);z-index:250;padding:9px 18px;border-radius:999px;font-size:13px;font-weight:700;background:var(--panel);color:var(--text);border:1px solid var(--border-hot);box-shadow:0 8px 24px rgba(0,0,0,.45);backdrop-filter:blur(12px);pointer-events:none;transition:transform .2s ease,opacity .2s ease;opacity:0;display:flex;align-items:center;gap:8px;white-space:nowrap}
.ptr-banner.visible{opacity:1}
.ptr-banner.ready{background:#1e6cf2;color:#fff;border-color:#1e6cf2;box-shadow:0 6px 20px rgba(30,108,242,.5)}

body.compact header{padding:8px 10px;gap:6px}
body.compact .ct{padding:10px}
body.compact .title{font-size:17px;margin-bottom:10px}
body.compact .card{padding:10px 12px;margin-bottom:8px}
body.compact .item{padding:8px 10px;margin-bottom:6px}
body.compact .person{padding:6px;margin:3px 0}
body.compact .field{margin-bottom:8px}
body.compact .muted{font-size:12px}
body.compact input,body.compact select,body.compact textarea{padding:7px 9px;font-size:15px}
body.compact button,body.compact .btn{padding:7px 12px;font-size:13px}
body.compact .small-btn{padding:4px 8px;font-size:12px}
body.compact .grid{gap:6px}
body.compact .inline-actions{gap:6px}
body.compact nav.bottom button{padding:4px 0;font-size:11px}
body.compact nav.bottom button span{font-size:16px}
@media(max-width:540px){
  .grid{grid-template-columns:repeat(2,1fr)}
  .row{grid-template-columns:1fr;gap:0}
  .title{font-size:19px}
  .dtr-paper{overflow-x:auto}
  .dp-table{min-width:760px}
  .dp-employee-sign{min-width:240px}
}
@media(max-width:380px){
  .grid{grid-template-columns:1fr 1fr}
  nav.bottom button{font-size:10px}
  .ct{padding:10px}
}
@media print{
  header,.ticker,nav.bottom,#toastBox,.ptr-banner{display:none!important}
  main{max-width:none}
  body{background:#fff!important;color:#000!important}
  @page{size:8.5in 5.5in;margin:0.2in}
  .page{display:none!important}
  #page-dtr{display:block!important}
  #dtrFill,.dtr-tabs,.dtr-actions,#dtrExportHint{display:none!important}
  #dtrPreview{display:block!important}
  .dtr-paper{width:8.1in;height:5.1in;max-width:none;aspect-ratio:auto;overflow:hidden;box-shadow:none;border:0}
  .dp-table{min-width:0}
  #page-dtr .title{display:none}
}
@media(display-mode:standalone){
  header{padding-top:calc(12px + env(safe-area-inset-top))}
  body{padding-top:0}
}

