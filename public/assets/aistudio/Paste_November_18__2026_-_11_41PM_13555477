          <div class="field"><label for="schDate">Date</label><input id="schDate" type="date"></div>
          <div class="field"><label for="schPriority">Priority</label><select id="schPriority"><option>Normal</option><option>High</option><option>Urgent</option></select></div>
        </div>
        <div class="row">
          <div class="field"><label for="schIn">Time in</label><input id="schIn" type="time"></div>
          <div class="field"><label for="schOut">Time out</label><input id="schOut" type="time"></div>
        </div>
        <div class="field"><label>Assign Personnel (Multi-select categorized by Region / Team)</label><div id="assigneesPicker" class="person-picker"></div></div>
