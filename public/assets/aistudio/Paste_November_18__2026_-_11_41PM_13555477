function runSearch() {
  const q = ($("searchQuery").value || "").toLowerCase().trim();
  const region = $("searchRegion")?.value || "";
  const equip = $("searchEquipment")?.value || "";
  const type = $("searchType")?.value || "";
  const site = $("searchSite")?.value || "";
  const from = $("searchDateFrom")?.value || "";
  const to = $("searchDateTo")?.value || "";
  const hits = [];

  if (!type || type === "service-report" || type === "delivery-report") {
    state.reports.forEach(r => {
      if (type === "service-report" && r.report_type !== "service") return;
      if (type === "delivery-report" && r.report_type !== "delivery") return;
      const sObj = state.sites.find(s => String(s.id) === String(r.site_id));
      if (region && (!sObj || sObj.region !== region)) return;
      if (site && String(r.site_id) !== site) return;
      if (from && r.report_date < from) return;
      if (to && r.report_date > to) return;
      const hay = ((r.title || "") + " " + (r.details || "") + " " + (sObj?.name || "")).toLowerCase();
      if (equip && !hay.includes(equip)) return;
      if (q && !hay.includes(q)) return;
      const bodyText = (r.details || "").split("\n\nPhotos:\n")[0];
      const photosHtml = extractReportPhotoUrls(r.details).map(safeUrl).filter(Boolean).map(u => {
        if (isImageUrl(u)) return '<img src="' + esc(u) + '" alt="Photo" onclick="window.open(\'' + esc(u) + '\',\'_blank\',\'noopener\')">';
        const fname = decodeURIComponent((u.split("/").pop() || "File").replace(/^\d+-\d+-[a-z0-9]+-/, ""));
        return '<a class="report-att-item" href="' + esc(u) + '" target="_blank" rel="noopener" style="text-decoration:none;"><span class="report-att-file">📎 ' + esc(fname) + '</span></a>';
      }).join("");
      hits.push({
        kind: (r.report_type === "delivery" ? "Delivery" : "Service") + " Report",
        title: r.title,
        date: fmtDay(r.report_date) + (sObj ? " · " + sObj.name : "") + " · " + profileName(r.created_by),
        body: bodyText.slice(0, 260),
        photosHtml
      });
    });
  }
  if (!type || type === "pms") {
    state.pmsRecords.forEach(r => {
      if (equip && r.unit_type !== equip) return;
      const sObj = state.sites.find(s => String(s.id) === String(r.site_id));
      if (region && (!sObj || sObj.region !== region)) return;
      if (site && String(r.site_id) !== site) return;
      if (from && r.checklist_date < from) return;
      if (to && r.checklist_date > to) return;
      const hay = ((sObj?.name || "") + " " + (r.unit_type || "") + " " + (r.details || "")).toLowerCase();
      if (q && !hay.includes(q)) return;
      hits.push({ kind: "PMS (" + r.unit_type + ")", title: sObj ? sObj.name : "Site", date: fmtDay(r.checklist_date) + " · " + profileName(r.user_id), body: r.items_passed + "/" + r.items_total + " passed" });
    });
  }
  if (!type || type === "unit") {
    state.units.forEach(u => {
      if (equip && !String(u.unit_type || "").includes(equip)) return;
      const sObj = state.sites.find(s => String(s.id) === String(u.site_id));
      if (region && (!sObj || sObj.region !== region)) return;
      if (site && String(u.site_id) !== site) return;
      const hay = ((u.unit_name || "") + " " + (u.unit_type || "") + " " + (u.brand_model || "") + " " + (u.serial_no || "") + " " + (u.notes || "") + " " + (sObj?.name || "")).toLowerCase();
      if (q && !hay.includes(q)) return;
      hits.push({ kind: "Unit (" + u.status + ")", title: u.unit_name + (sObj ? " — " + sObj.name : ""), date: fmtDate(u.created_at), body: [u.unit_type, u.brand_model, u.capacity_floors, u.notes].filter(Boolean).join(" · ") });
    });
  }
  if (!type || type === "rec") {
    state.recs.forEach(r => {
      if (region || site) {
        const sObj = state.sites.find(s => (s.name || "").toLowerCase() === (r.site || "").toLowerCase());
        if (region && (!sObj || sObj.region !== region)) return;
        if (site && (!sObj || String(sObj.id) !== site)) return;
      }
      const hay = ((r.part || "") + " " + (r.reason || "") + " " + (r.site || "")).toLowerCase();
      if (equip && !hay.includes(equip)) return;
      if (q && !hay.includes(q)) return;
      hits.push({ kind: "Recommendation", title: r.part, date: fmtDate(r.created_at), body: r.reason || "" });
    });
  }
  if (!type || type === "note") {
    state.notes.forEach(n => {
      if (region || site) return;
      const hay = ((n.title || "") + " " + (n.body || "")).toLowerCase();
      if (equip && !hay.includes(equip)) return;
      if (q && !hay.includes(q)) return;
      hits.push({ kind: "Note", title: n.title, date: fmtDate(n.created_at), body: (n.body || "").slice(0, 260) });
    });
  }
  $("searchResults").innerHTML = hits.map(h =>
    '<div class="item"><b>' + esc(h.title) + '</b><div class="muted">' + esc(h.kind) + ' · ' + esc(h.date) + '</div><div>' + esc(h.body) + '</div>' +
    (h.photosHtml ? '<div class="media-grid" style="margin-top:8px;">' + h.photosHtml + '</div>' : '') + '</div>'
  ).join("") || '<p class="muted">No matching reports or records.</p>';
}
