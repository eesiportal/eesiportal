        <div class="tile clickable" onclick="go('schedule')"><span class="ic">📅</span>Schedule</div>
        <div class="tile clickable" onclick="go('sites')"><span class="ic">📍</span>Sites</div>
        <div class="tile clickable" onclick="go('dtr')"><span class="ic">⏰</span>DTR</div>
