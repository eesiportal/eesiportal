body.light .sheet::before{background:#1e6cf2}
body.light button{color:#1d4f9c;background:rgba(30,108,242,.08);border:1px solid rgba(30,108,242,.3);box-shadow:0 3px 10px rgba(19,35,63,.16)}
body.light button:hover:not(:disabled){background:rgba(30,108,242,.15);box-shadow:0 5px 14px rgba(30,108,242,.26)}
body.light .btn,body.light .chat-send{background:#1e6cf2;color:#ffffff;border:1px solid #1e6cf2;box-shadow:0 4px 14px rgba(30,108,242,.38)}
body.light .btn:hover:not(:disabled){background:#2f7cff;box-shadow:0 6px 18px rgba(30,108,242,.48)}
