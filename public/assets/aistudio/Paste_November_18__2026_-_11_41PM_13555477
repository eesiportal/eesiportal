  c.stream.getTracks().forEach(t => c.pc.addTrack(t, c.stream));
  $("callLocal").srcObject = c.stream;
}
function showCallScreen(c, status) {
  $("callScreen").classList.remove("hidden"); $("callScreen").classList.toggle("audio", c.kind !== "video");
  $("callName").textContent = c.peerName || "Call"; $("callFace").innerHTML = bigFace(profileOf(c.peerId));
  $("callLocal").classList.toggle("hidden", c.kind !== "video"); $("callCamBtn").classList.toggle("hidden", c.kind !== "video");
  $("callMuteBtn").textContent = "Mute"; $("callCamBtn").textContent = "Camera off"; setCallStatus(status);
}
function setCallStatus(text) { const el = $("callStatus"); if (el) el.textContent = text; }
function attachRemote() { const v = $("callRemote"); v.srcObject = call.remote; v.play().catch(() => {}); }
function startCallClock() {
