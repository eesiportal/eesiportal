let locationWatchId = null;
window.startEmployeeLocationSharing = function () {
  if (!navigator.geolocation) { $("locationStatus").classList.remove("hidden"); $("locationStatus").textContent = "This device cannot share location."; return; }
  if (!state.userId || locationWatchId != null) return;
  $("locationStatus").classList.remove("hidden"); $("locationStatus").textContent = "Sharing location…";
  locationWatchId = navigator.geolocation.watchPosition(async pos => {
    if (pos.coords.accuracy > 100) { $("locationStatus").textContent = "Waiting for a better GPS fix (±" + Math.round(pos.coords.accuracy) + " m)…"; return; }
    const { latitude, longitude } = pos.coords;
    $("locationStatus").textContent = "Sharing: " + latitude.toFixed(4) + ", " + longitude.toFixed(4);
    if (Math.abs(latitude - lastWeatherLat) > 0.02 || Math.abs(longitude - lastWeatherLon) > 0.02) {
      updateLiveWeather(latitude, longitude);
    }
    await client.from("employee_locations").upsert({ user_id: state.userId, latitude, longitude, updated_at: new Date().toISOString() }, { onConflict: "user_id" });
  }, err => { $("locationStatus").textContent = "Location error: " + err.message; }, { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 });
};

let liveMapInstance = null, liveMapLayer = null, liveBase = null, liveLabels = null;
let liveFitted = false, liveBusy = false, liveLastPoints = [];
const liveMarkers = new Map();
const LIVE_REFRESH_MS = 15000, LIVE_STALE_MS = 5 * 60 * 1000;
const BASEMAPS = {
  map: {
    url: "https://mt{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}",
    opts: { subdomains: ["0", "1", "2", "3"], maxZoom: 20, maxNativeZoom: 20, attribution: "Map data &copy; Google" }
  },
  satellite: {
    url: "https://mt{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}",
    opts: { subdomains: ["0", "1", "2", "3"], maxZoom: 20, maxNativeZoom: 20, attribution: "Imagery &copy; Google" }
  },
  terrain: {
    url: "https://mt{s}.google.com/vt/lyrs=p&x={x}&y={y}&z={z}",
    opts: { subdomains: ["0", "1", "2", "3"], maxZoom: 20, maxNativeZoom: 20, attribution: "Terrain &copy; Google" }
  }
};
function setBasemap(name) {
  if (!liveMapInstance || !BASEMAPS[name]) return;
  if (liveBase) liveMapInstance.removeLayer(liveBase);
  if (liveLabels) { liveMapInstance.removeLayer(liveLabels); liveLabels = null; }
  const b = BASEMAPS[name];
  liveBase = L.tileLayer(b.url, b.opts).addTo(liveMapInstance);
  localStorage.setItem("eesi-basemap", name);
  document.querySelectorAll("[data-basemap]").forEach(btn => btn.classList.toggle("active", btn.dataset.basemap === name));
}
function ensureLiveMap() {
  if (liveMapInstance || !window.L) return liveMapInstance;
  liveMapInstance = L.map("liveMap").setView([12.8797, 121.774], 6);
  liveMapLayer = L.layerGroup().addTo(liveMapInstance);
  const saved = localStorage.getItem("eesi-basemap");
  setBasemap(BASEMAPS[saved] ? saved : "map");
  return liveMapInstance;
}
function fitLiveMap(points) {
  if (!liveMapInstance || !points.length) return;
  if (points.length === 1) liveMapInstance.setView(points[0], 16);
  else liveMapInstance.fitBounds(points, { padding: [30, 30], maxZoom: 16 });
}
window.focusLiveEmployee = function (userId) {
  const m = liveMarkers.get(userId);
  if (!m || !liveMapInstance) return;
  liveMapInstance.setView(m.getLatLng(), 17, { animate: true });
  m.openPopup();
  $("liveMap")?.scrollIntoView({ behavior: "smooth", block: "center" });
};
async function loadLiveMap(opts = {}) {
  if (!$("liveMap") || !isAdmin() || liveBusy) return;
  liveBusy = true;
  try {
    const { data, error } = await client.from("employee_locations").select("user_id,latitude,longitude,updated_at");
    if (error) throw error;
    if (!window.L) { $("liveLocationStatus").textContent = "Map library is still loading. Try again in a moment."; return; }
    const map = ensureLiveMap();
    const rows = (data || []).filter(r => Number.isFinite(+r.latitude) && Number.isFinite(+r.longitude));
    const now = Date.now(), seen = new Set(), points = [], items = [];
    rows.forEach(row => {
      const p = profileOf(row.user_id), name = p ? p.full_name : "Member";
      const fresh = now - new Date(row.updated_at).getTime() <= LIVE_STALE_MS;
      const ll = [+row.latitude, +row.longitude];
      const color = fresh ? "#22c55e" : "#94a3b8";
      const popup = "<b>" + esc(name) + "</b><br>" + esc(fmtDate(row.updated_at)) + (fresh ? "" : " (stale)");
      seen.add(row.user_id); points.push(ll); items.push({ row, name, fresh });
      let m = liveMarkers.get(row.user_id);
      if (!m) {
        m = L.circleMarker(ll, { radius: 9, color: "#ffffff", weight: 2, fillColor: color, fillOpacity: 1 }).bindPopup(popup).addTo(liveMapLayer);
        liveMarkers.set(row.user_id, m);
      } else {
        m.setLatLng(ll); m.setStyle({ fillColor: color }); m.setPopupContent(popup);
      }
    });
    for (const [id, m] of liveMarkers) if (!seen.has(id)) { liveMapLayer.removeLayer(m); liveMarkers.delete(id); }
    map.invalidateSize();
    liveLastPoints = points;
    if (opts.fit || !liveFitted) { fitLiveMap(points); liveFitted = points.length > 0; }
    const freshCount = items.filter(i => i.fresh).length;
    $("liveLocationStatus").textContent = rows.length + " location(s), " + freshCount + " updated in the last 5 minutes. Last refresh " + new Date().toLocaleTimeString() + ".";
    $("liveLocationList").innerHTML = items.map(({ row, name, fresh }) =>
      '<div class="item" style="display:flex;justify-content:space-between;align-items:center;gap:8px;"><div><b>' + esc(name) + '</b> <span class="sess-badge ' + (fresh ? "now" : "") + '"' + (fresh ? "" : ' style="background:#94a3b8;"') + '>' + (fresh ? "LIVE" : "STALE") + '</span>' +
      '<div class="muted">' + esc(fmtDate(row.updated_at)) + '</div></div>' +
      '<div class="inline-actions" style="margin-top:0"><button class="gray small-btn" type="button" onclick="focusLiveEmployee(\'' + esc(row.user_id) + '\')">📍 Focus</button><a href="https://www.google.com/maps?q=' + encodeURIComponent(row.latitude + "," + row.longitude) + '" target="_blank" rel="noopener">Open</a></div></div>'
    ).join("") || '<p class="muted">No location data yet.</p>';
  } catch (err) {
    $("liveLocationStatus").textContent = "Could not load locations: " + err.message;
  } finally { liveBusy = false; }
}
