function localDateKey(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
function sessionState(s) {
  if (!s.scheduled_date || !s.time_in) return "";
  const start = new Date(s.scheduled_date + "T" + s.time_in);
  const end = s.time_out ? new Date(s.scheduled_date + "T" + s.time_out) : new Date(start.getTime() + 3600000);
  if (isNaN(start)) return "";
  const now = Date.now();
  if (now >= start.getTime() && now <= end.getTime()) return "now";
  const dayOk = s.scheduled_date === localDateKey(new Date()) || s.scheduled_date === localDateKey(new Date(now + 86400000));
  if (start.getTime() > now && start.getTime() - now <= 86400000 && dayOk) return "soon";
  return "";
}
function sessionBadge(s) {
  const st = sessionState(s);
  if (st === "now") return '<span class="sess-badge now">● NOW</span>';
  if (st === "soon") return '<span class="sess-badge soon">⏳ UPCOMING</span>';
  return "";
}
