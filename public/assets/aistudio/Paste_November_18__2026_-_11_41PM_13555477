async function handleChatInfoAction(act, threadId) {
  const pref = getPref(threadId);
  const t = state.threads.find(x => x.id === threadId);
  const other = t && t.kind === "direct" ? threadMembers(t).find(m => m.user_id !== state.userId) : null;
  if (act === "chat-media") {
    const imgs = state.messages.filter(m => !m.deleted_at && (m.attachment_type || "").startsWith("image/") && safeUrl(m.attachment_url));
    openSheet('<h2>Media</h2>' + (imgs.map(m => '<div class="media-item"><img src="' + esc(safeUrl(m.attachment_url)) + '" alt=""><span class="media-name">' + esc(m.attachment_name || "Photo") + '</span></div>').join("") || '<p class="muted">No media yet.</p>') + sheetClose()); return;
  }
  if (act === "open-pinned-sheet") return window.openPinnedSheet(threadId);
  if (act === "chat-members") return window.openMembersSheet(threadId);
  if (act === "chat-add" && t) {
    const existing = new Set(threadMembers(t).map(m => m.user_id));
    const candidates = state.profiles.filter(p => !existing.has(p.user_id));
    openSheet('<h2>Add people</h2>' + (candidates.map(p => '<button class="sheet-btn" onclick="addMemberToGroup(\'' + esc(t.id) + '\',\'' + esc(p.user_id) + '\')">➕ ' + esc(p.full_name) + '</button>').join("") || '<p class="muted">Everyone is already in this group.</p>') + sheetClose());
    return;
  }
  if (act === "new-autosave") { setPref(threadId, { autosave: !pref.autosave }); refreshChatViews(); toast("Auto-save " + (!pref.autosave ? "on" : "off")); return; }
  if (act === "new-mute") { const willMute = !isMuted(threadId); setPref(threadId, { mute: willMute ? "forever" : null }); refreshChatViews(); toast(willMute ? "Muted" : "Unmuted"); return; }
  if (act === "new-receipts") { setPref(threadId, { receipts: pref.receipts === false }); refreshChatViews(); return; }
  if (act === "new-typing") { setPref(threadId, { typing: pref.typing === false }); refreshChatViews(); return; }
  if (act === "chat-share") { const p = profileOf(threadId); if (p) { await navigator.clipboard.writeText((p.full_name || "") + " · " + (p.phone || p.email || "")); toast("Contact copied"); } return; }
  if (act === "new-block-dm" && other) {
    const isBlocked = state.blockedUsers.includes(other.user_id);
    if (isBlocked) {
      await client.from("user_blocks").delete().eq("blocker_id", state.userId).eq("blocked_id", other.user_id);
      toast("Unblocked");
    } else {
      if (!confirm("Block this member?")) return;
      await client.from("user_blocks").insert({ blocker_id: state.userId, blocked_id: other.user_id });
      toast("Blocked");
    }
    await loadBlockedUsers(); renderChatInfo();
    document.querySelector(".chat-composer")?.classList.toggle("hidden", !isBlocked);
    return;
  }
  if (act === "chat-delete") { const h = pref.hiddenAt; setPref(threadId, { hiddenAt: h ? null : new Date().toISOString() }); refreshChatViews(); closeChat(); toast(h ? "Chat restored" : "Chat archived"); return; }
  if (act === "new-leave" && t) { if (!confirm("Leave this group?")) return; await client.from("thread_members").delete().eq("thread_id", t.id).eq("user_id", state.userId); closeChat(); await loadThreads(); toast("Left the group"); return; }
  const planned = PLANNED_FEATURES[act.replace("new-", "")];
  if (planned) openSheet('<h2>' + esc(planned[0]) + '</h2><p class="muted">' + esc(planned[1]) + '</p>' + sheetClose());
}
