<section id="authScreen" class="auth-screen">
  <div class="auth-wrap">
    <div class="auth-brand">
      <div class="auth-logo"><span class="logo-wrap"><svg viewBox="0 0 356 196" role="img" aria-label="EESI Elevators"><use href="#eesiLogo"/></svg><span class="logo-deco" aria-hidden="true"></span></span></div>
      <div>
        <div class="auth-brand-name">EESI ELEVATORS</div>
        <div class="auth-brand-sub">Operations console</div>
      </div>
    </div>
    <div class="auth-card">
      <form id="loginForm">
        <h2>Sign in</h2>
        <p class="lede">Use your approved company account.</p>
        <div class="field"><label for="email">Email</label><input id="email" type="email" autocomplete="username" required></div>
        <div class="field"><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required></div>
        <button id="loginButton" class="btn full" type="submit">Log in</button>
      </form>
      <form id="registerForm" class="hidden">
        <h2>Register</h2>
        <p class="lede">Registration requires administrator approval.</p>
        <div class="field"><label for="regName">Full name</label><input id="regName" autocomplete="name" required></div>
        <div class="field"><label for="regId">ID No.</label><input id="regId"></div>
        <div class="field"><label for="regAddress">Address</label><textarea id="regAddress"></textarea></div>
        <div class="field"><label for="regTeam">Team</label><input id="regTeam"></div>
        <div class="field"><label for="regPhone">Contact / cellphone</label><input id="regPhone" type="tel" autocomplete="tel"></div>
        <div class="field"><label for="regArea">Area / Region</label><select id="regArea" required><option value="">Select area</option><option>Visayas</option><option>Luzon</option><option>Mindanao</option></select></div>
        <div class="field"><label for="regEmail">Email</label><input id="regEmail" type="email" autocomplete="email" required></div>
        <div class="field"><label for="regPassword">Password</label><input id="regPassword" type="password" minlength="8" autocomplete="new-password" required></div>
        <div class="field"><label for="regRole">Requested designation</label><select id="regRole" required><option value="technician">Technician</option><option value="representative">Selective Representative</option></select></div>
        <button id="registerButton" class="btn full" type="submit">Submit registration</button>
        <button id="backLoginButton" class="gray full" type="button">Back to log in</button>
      </form>
      <form id="resetForm" class="hidden">
        <h2>Choose a new password</h2>
        <p class="lede">Enter a new password for your account.</p>
        <div class="field"><label for="newPassword">New password</label><input id="newPassword" type="password" minlength="8" autocomplete="new-password" required></div>
        <button class="btn full" type="submit">Update password</button>
        <button id="resetBackButton" class="gray full" type="button">Back to log in</button>
      </form>
      <div id="loginOptions">
        <div class="auth-links">
          <button id="forgotButton" class="text-button" type="button">Forgot password?</button>
          <button id="showRegisterButton" class="text-button" type="button">Register</button>
        </div>
        <div class="divider">or continue with</div>
        <button id="googleButton" class="social-button" type="button">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11a9.4 9.4 0 0 1-4.1 6.2v5h6.6c3.9-3.6 6.1-8.8 6.1-14.9z"/><path fill="#34A853" d="M24 44c5.5 0 10.1-1.8 13.5-4.8l-6.6-5c-1.8 1.2-4 2-6.9 2-5.3 0-9.8-3.6-11.4-8.5H5.8v5.2A20 20 0 0 0 24 44z"/><path fill="#FBBC05" d="M12.6 27.7a12 12 0 0 1 0-7.4v-5.2H5.8a20 20 0 0 0 0 17.8l6.8-5.2z"/><path fill="#EA4335" d="M24 11.8c3 0 5.7 1 7.8 3.1l5.8-5.8C34.1 5.8 29.5 4 24 4A20 20 0 0 0 5.8 15.1l6.8 5.2c1.6-4.9 6.1-8.5 11.4-8.5z"/></svg>
          Continue with Google
        </button>
        <button id="facebookButton" class="social-button" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#1877F2" d="M24 12a12 12 0 1 0-13.875 11.85v-8.38H7.078V12h3.047V9.356c0-3.007 1.791-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.513c-1.49 0-1.954.925-1.954 1.874V12h3.328l-.532 3.47h-2.796v8.38A12.002 12.002 0 0 0 24 12"/></svg>
          Continue with Facebook
        </button>
      </div>
      <p id="authStatus" class="status" role="status">Loading…</p>
    </div>
  </div>
</section>

<div id="app" class="hidden">
  <header>
    <span class="logo-wrap"><svg class="hdr-logo" viewBox="0 0 356 196" role="img" aria-label="EESI Elevators"><use href="#eesiLogo"/></svg><span class="logo-deco" aria-hidden="true"></span></span>
    <div class="brand">EESI<span class="brand-long"> ELEVATORS INC.</span></div>
    <span id="liveDot" class="live-dot" data-live="0" title="Live sync status"></span>
    <button class="hbtn" type="button" onclick="go('notices')" aria-label="Notifications">🔔 <span id="bell"></span></button>
    <button class="hbtn" type="button" onclick="toggleSettingsMenu()" aria-label="Settings">⋮</button>
  </header>

  <div id="settingsMenu" class="card hidden">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <h2 style="margin:0;">Settings</h2>
      <button id="closeSettingsButton" class="gray" type="button" style="min-height:32px;min-width:32px;padding:4px;font-size:16px;border-radius:50%;display:grid;place-items:center;" aria-label="Close settings">✕</button>
    </div>

    <button class="gray settings-nav-btn" type="button" onclick="go('profile')"><span>👤 Profile</span><span>›</span></button>

    <button id="displaySettingsBtn" class="gray settings-nav-btn" type="button"><span>🎨 Display</span><span>▾</span></button>
    <div id="displaySettingsPanel" class="settings-subpanel hidden">
      <label for="settingTheme">Theme</label>
      <select id="settingTheme"><option value="dark">Dark</option><option value="light">Light</option></select>
      <label for="settingDecor">Decoration</label>
      <select id="settingDecor"><option value="auto">Auto (by date)</option><option value="off">Off</option><option value="christmas">Christmas</option><option value="holyweek">Holy Week</option><option value="newyear">New Year</option><option value="valentine">Valentine's</option><option value="allsaints">All Saints</option><option value="session">Session</option><option value="event">Event</option></select>
      <label for="settingFont">Font</label>
      <select id="settingFont">
        <option value="system">Inter (Default)</option>
        <option value="poppins">Poppins (Modern)</option>
        <option value="montserrat">Montserrat (Geometric)</option>
        <option value="rajdhani">Rajdhani</option>
        <option value="orbitron">Orbitron (Robotic)</option>
        <option value="cinzel">Cinzel (Classic Serif)</option>
        <option value="playfair">Playfair Display (Editorial)</option>
        <option value="robotomono">Roboto Mono (Technical)</option>
        <option value="dancing">Dancing Script (Handwritten)</option>
        <option value="pacifico">Pacifico (Brush Script)</option>
        <option value="segoe">Segoe UI / System</option>
        <option value="arial">Arial</option>
        <option value="verdana">Verdana</option>
        <option value="trebuchet">Trebuchet MS</option>
        <option value="georgia">Georgia</option>
        <option value="times">Times New Roman</option>
        <option value="courier">Courier New</option>
      </select>
      <label for="settingWeight">Font weight</label>
      <select id="settingWeight">
        <option value="light">Light</option>
        <option value="regular">Regular</option>
        <option value="semibold">Semi-Bold</option>
        <option value="bold">Bold</option>
      </select>
      <label for="settingStyle">Font style</label>
      <select id="settingStyle">
        <option value="regular">Regular</option>
        <option value="italic">Italic</option>
        <option value="oblique">Oblique (Slanted)</option>
        <option value="uppercase">All Caps</option>
        <option value="capitalize">Title Case</option>
        <option value="wide">Wide Spacing</option>
        <option value="smallcaps">Small Caps</option>
      </select>
      <label for="settingTextSize">Text size</label>
      <select id="settingTextSize"><option value="xs">Extra small</option><option value="small">Small</option><option value="regular">Regular</option><option value="large">Large</option></select>
      <label><input id="settingCompact" type="checkbox"> Compact layout</label>
      <button class="gray" type="button" style="width:100%" onclick="resetDisplaySettings()">Reset display settings</button>
    </div>

    <button id="appSettingsBtn" class="gray settings-nav-btn" type="button"><span>⚙️ App Settings</span><span>▾</span></button>
    <div id="appSettingsPanel" class="settings-subpanel hidden">
      <h3 style="margin-top:4px">App Lock</h3>
      <div class="settings-row" style="padding:8px 0">
        <span>App Lock (6-digit PIN)</span>
        <span id="appLockState" class="muted">Off</span>
      </div>
      <button id="setPinBtn" class="gray" type="button" style="width:100%" onclick="openPinSetup(false)">Set PIN</button>
      <button id="changePinBtn" class="gray hidden" type="button" style="width:100%" onclick="openPinSetup(true)">Change PIN</button>
      <button id="removePinBtn" class="red hidden" type="button" style="width:100%" onclick="openPinSetup('remove')">Turn off PIN</button>

      <h3>Notifications</h3>
      <button id="enablePushBtn" class="btn" type="button" style="width:100%;margin:8px 0">Enable background notifications</button>
      <label><input id="settingNotifications" type="checkbox" checked> In-app notifications</label>
      <label><input id="settingVibration" type="checkbox"> Vibration (with or without sound)</label>
      <div style="display:flex;gap:8px;margin:8px 0">
        <button id="builtInSoundChoice" class="btn" type="button" style="flex:1">Built-in sounds</button>
        <button id="customSoundChoice" class="gray" type="button" style="flex:1">Custom ringtone</button>
      </div>
      <div id="builtInSoundPanel">
        <label for="settingSound">Sound</label>
        <select id="settingSound">
          <option value="off">Off (Silent / Vibration only)</option>
          <option value="classic">Classic polyphonic</option>
          <option value="bright">Bright chime</option>
          <option value="digital">Digital pulse</option>
          <option value="retro">Retro ringtone</option>
          <option value="soft">Soft marimba</option>
          <option value="bell">Warm bell</option>
        </select>
        <label for="settingAlertDuration">Alert duration</label>
        <select id="settingAlertDuration">
          <option value="0">Off</option>
          <option value="5">5 seconds</option>
          <option value="10">10 seconds</option>
          <option value="15">15 seconds</option>
          <option value="30">30 seconds</option>
          <option value="60">1 minute</option>
        </select>
      </div>
      <div id="customSoundPanel" class="hidden">
        <label for="settingCustomAlertDuration">Custom ringtone duration</label>
        <select id="settingCustomAlertDuration">
          <option value="0">Off</option>
          <option value="10">10 seconds</option>
          <option value="15">15 seconds</option>
          <option value="30">30 seconds</option>
          <option value="60">1 minute</option>
        </select>
        <label for="settingSoundFile">Custom ringtone file</label>
        <div style="display:flex;gap:6px;align-items:center">
          <input id="settingSoundFile" type="file" accept="audio/*">
          <button id="clearSoundFileButton" class="gray" type="button" aria-label="Clear custom ringtone" title="Clear custom ringtone">×</button>
        </div>
      </div>
      <button class="gray" type="button" style="width:100%" onclick="previewNotificationSound()">Preview sound / vibration</button>
    </div>

    <h3>Account</h3>
    <button class="gray" type="button" style="width:100%" onclick="changePassword()">Change password</button>
    <button class="red" type="button" style="width:100%" onclick="signOut()">Sign out</button>
  </div>

  <div id="ticker" class="ticker"><span id="tickerText"></span></div>

  <main>
