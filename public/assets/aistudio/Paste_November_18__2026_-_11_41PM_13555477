        <button class="btn manager-only hidden" type="button" id="toggleScheduleFormBtn" style="font-size:20px;width:44px;padding:0;display:grid;place-items:center;">＋</button>
      </div>
      <div id="scheduleFormCard" class="card hidden">
        <div class="field"><label for="schRegion">Region</label><select id="schRegion" onchange="renderAssigneesPicker()"><option>Visayas</option><option>Luzon</option><option>Mindanao</option></select></div>
