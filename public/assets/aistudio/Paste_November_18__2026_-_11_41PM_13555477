function queueReload(table) {
  clearTimeout(timers[table]);
  timers[table] = setTimeout(async () => {
    delete timers[table]; if (!state.userId) return;
    const fn = RELOADERS[table]; if (fn) await fn();
    if (table !== "messages") { renderAll(); if (page === "admin") renderAdmin(); }
    if (!isWithinSelfActionWindow()) {
      if (table === "recommendations" || table === "recommendation_comments") {
        triggerAlert("📌 New Recommendation", "A new recommendation or comment was added.", [200, 100, 200]);
      } else if (table === "registration_requests" && isManager()) {
        triggerAlert("⏳ Pending Registration", "A new user is waiting for approval.", [200, 100, 200]);
      }
    }
  }, 280);
}
function teardownLive() {
  Object.keys(timers).forEach(t => { clearTimeout(timers[t]); delete timers[t]; });
  clearTimeout(retryTimer); retryTimer = null;
  lastOnlineKey = "";
  if (locationWatchId != null && navigator.geolocation) {
    navigator.geolocation.clearWatch(locationWatchId);
    locationWatchId = null;
  }
  if (realtimeChannel) { client.removeChannel(realtimeChannel); realtimeChannel = null; }
  if (presenceChannel) { client.removeChannel(presenceChannel); presenceChannel = null; }
  if (call) endCall(null, false); hideIncoming(); stopCallListener();
  if (typingChannel) { client.removeChannel(typingChannel); typingChannel = null; }
  clearTimeout(typingTimeout); typingTimeout = null; clearTimeout(typingSendTimeout); typingSendTimeout = null;
  state.presence = {}; setLive(false);
}
function startLive() {
  teardownLive(); if (!state.userId) return;
  const channel = client.channel("eesi-db-" + state.userId);
  LIVE_TABLES.forEach(table => channel.on("postgres_changes", { event: "*", schema: "public", table }, () => queueReload(table)));
  channel.subscribe(status => {
    if (status === "SUBSCRIBED") {
      liveRetryDelay = 15000;
      setLive(true);
    } else if (status === "CHANNEL_ERROR" || status === "TIMED_OUT") {
      setLive(false);
      clearTimeout(retryTimer);
      retryTimer = setTimeout(() => { if (state.userId) startLive(); }, liveRetryDelay);
      liveRetryDelay = Math.min(60000, liveRetryDelay * 2);
    } else if (status === "CLOSED") {
      setLive(false);
    }
  });
  realtimeChannel = channel;
  const presence = client.channel("eesi-presence", { config: { presence: { key: state.userId } } });
  presence.on("presence", { event: "sync" }, () => {
    state.presence = presence.presenceState();
    const key = [...onlineIds()].sort().join(",");
    if (key === lastOnlineKey) return;
    lastOnlineKey = key;
    renderOnline(); renderMembers(); renderHome(); renderChatList();
  });
  presence.subscribe(async status => {
    if (status === "SUBSCRIBED") {
      await presence.track({ user_id: state.userId, name: state.profile?.full_name || state.email, online_at: new Date().toISOString() });
    }
  });
  presenceChannel = presence; startCallListener();
}
