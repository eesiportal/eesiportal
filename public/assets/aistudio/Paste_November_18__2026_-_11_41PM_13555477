}
async function startCall(kind) {
  const t = state.threads.find(x => x.id === state.activeThread);
  if (!t || t.kind !== "direct") return toast("Calls work in one-on-one chats");
  if (call || incoming) return toast("You are already in a call");
  const other = threadMembers(t).find(m => m.user_id !== state.userId);
  if (!other) return toast("No one to call");
  if (!callChannel || callChannel.state !== "joined") return toast("Calls need a live connection. Wait for the live dot.");
  if (!onlineIds().has(other.user_id)) return toast(profileName(other.user_id) + " is offline right now");
  const id = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : Date.now() + "-" + Math.random().toString(16).slice(2);
  const c = newCall(id, other.user_id, profileName(other.user_id), kind, "caller");
