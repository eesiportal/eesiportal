async function ensureProfile(session) {
  const { data, error } = await client.from("profiles").select("user_id,full_name,email,id_no,address,team,phone,area,avatar_url,cover_url").eq("user_id", session.user.id).maybeSingle();
  if (error) throw error;
  if (data) return data;
  const fullName = session.user.user_metadata?.full_name || session.user.user_metadata?.name || (session.user.email || "Member").split("@")[0];
  const { data: created, error: insertError } = await client.from("profiles").upsert({ user_id: session.user.id, full_name: fullName, email: session.user.email }, { onConflict: "user_id" }).select("user_id,full_name,email,id_no,address,team,phone,area,avatar_url,cover_url").maybeSingle();
  if (insertError) throw insertError;
  return created || { user_id: session.user.id, full_name: fullName, email: session.user.email };
}
async function ensurePendingRequest(session) {
  const { data: existing } = await client.from("registration_requests").select("id").eq("user_id", session.user.id).maybeSingle();
  if (existing) return;
  const fullName = session.user.user_metadata?.full_name || session.user.user_metadata?.name || (session.user.email || "Member").split("@")[0];
  await client.from("registration_requests").insert({ user_id: session.user.id, full_name: fullName, email: session.user.email, requested_role: "technician", status: "pending" });
}

async function bootInner(session) {
  if (state.booted && state.userId === session.user.id) return;
  const run = ++authRun;
  const { data: roleRow, error: roleError } = await client.from("user_roles").select("app_role,approval_status").eq("user_id", session.user.id).maybeSingle();
  if (run !== authRun) return;
  if (roleError) { showAuth("Role check failed: " + roleError.message); return; }
  if (!roleRow || roleRow.approval_status !== "approved") {
    if (!roleRow) await ensurePendingRequest(session);
    await client.auth.signOut();
    return showAuth("Your account is awaiting approval. You can sign in once an administrator approves it.");
  }

  let profile;
  try { profile = await ensureProfile(session); }
  catch (err) { return showAuth("Database setup required. Contact administrator. (" + err.message + ")"); }
  if (run !== authRun) return;

  state.userId = session.user.id; state.email = session.user.email; state.role = roleRow.app_role; state.profile = profile;
  loadSavedSignaturePhoto(); await loadSavedDrawnSignature();
  state.setupIssue = ""; $("setupWarn").classList.add("hidden");
  $("welcome").textContent = profile.full_name || session.user.email;
  $("roleLabel").textContent = roleLabel(state.role);
  updateAccess(); showApp(); checkAppLock(); requestNotificationPermission();
  applyTheme(localStorage.getItem("eesi-theme") || "dark");
  applyDisplaySettings(); startClock(); updateLiveWeather(); startEmployeeLocationSharing(); renderDecor();
  showDailyVerse();

  await Promise.all([
    loadBlockedUsers(), loadProfiles(), loadRoles(), loadSites(), loadUnits(), loadSchedules(), loadDtrs(),
    loadNotes(), loadRecs(), loadAnnouncements(), loadPending(), loadLeaveRequests(), loadPmsRecords()
  ]);
  await loadThreads(); await loadUnread(); await loadRecentChatNotices();
  if (run !== authRun) return;

  state.booted = true;
  renderAssigneesPicker(); renderAll(); startLive();
}

let booting = false;
async function boot(session) {
  if (booting) return;
  if (state.booted && state.userId === session.user.id) return;
  booting = true;
  try {
    await bootInner(session);
    if (!state.booted) return;
    await loadReports();
