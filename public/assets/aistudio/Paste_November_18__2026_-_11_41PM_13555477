  try {
    const r = await fetch("https://api.open-meteo.com/v1/forecast?latitude=" + lat + "&longitude=" + lon + "&current=temperature_2m,relative_humidity_2m,weather_code&timezone=auto");
    const j = await r.json(); const c = j.current || {};
    const codes = { 0: "Clear", 1: "Mostly clear", 2: "Partly cloudy", 3: "Overcast", 45: "Fog", 51: "Drizzle", 61: "Rain", 63: "Rain", 65: "Heavy rain", 80: "Showers", 95: "Thunderstorm" };
    el.textContent = (c.temperature_2m != null ? c.temperature_2m + "°C · " : "") + (codes[c.weather_code] || "—") + (c.relative_humidity_2m != null ? " · " + c.relative_humidity_2m + "% humidity" : "");
  } catch (err) { el.textContent = "Weather unavailable."; }
}
