async function approveRequest(id, approve) {
  const req = state.pending.find(r => String(r.id) === String(id)); if (!req) return;
  if (approve) {
    const { error: roleErr } = await client.from("user_roles").upsert({ user_id: req.user_id, app_role: req.requested_role || "technician", approval_status: "approved" }, { onConflict: "user_id" });
    if (roleErr) return toast("Could not approve: " + roleErr.message);
    await client.from("profiles").upsert({ user_id: req.user_id, full_name: req.full_name, email: req.email, id_no: req.id_no, address: req.address, team: req.team, phone: req.phone, area: req.area }, { onConflict: "user_id" });
  }
  const { error } = await client.from("registration_requests").update({ status: approve ? "approved" : "declined" }).eq("id", id);
  if (error) return toast("Could not update: " + error.message);
  await client.from("approval_notifications").insert({ recipient_user_id: req.user_id, title: approve ? "Account approved" : "Registration declined", body: approve ? "You can now sign in to EESI Ops." : "Contact an administrator for details." });
  suppressNotifications(); await loadPending(); if (approve) { await loadProfiles(); await loadRoles(); }
  toast(approve ? "Approved" : "Declined");
}

