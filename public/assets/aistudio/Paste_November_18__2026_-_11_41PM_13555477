window.saveUnit = async function () {
  if (!checkNetwork()) return;
  const siteId = $("unitSite").value;
  const unitName = $("unitName").value.trim();
  if (!siteId || !unitName) return toast("Select a work site and enter a unit name");
  const payload = {
    site_id: siteId,
    unit_name: unitName,
    unit_type: $("unitType").value,
    status: $("unitStatus").value,
    brand_model: $("unitBrand").value.trim() || null,
    serial_no: $("unitSerial").value.trim() || null,
    capacity_floors: $("unitCapacity").value.trim() || null,
    notes: $("unitNotes").value.trim() || null
