    if (reqError) return setAuthStatus("Account created, but approval request failed: " + reqError.message);
    if (data.session) await client.auth.signOut();
    $("registerForm").reset(); showLoginForm();
    setAuthStatus("Registration submitted. Wait for approval before signing in.");
  } finally {
    isRegistering = false;
  }
