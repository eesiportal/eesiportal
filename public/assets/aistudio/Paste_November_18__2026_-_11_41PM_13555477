/* ==================== CALLS (WebRTC + Supabase Broadcast) ==================== */
const RTC_CONFIG = { iceServers: [{ urls: "stun:stun.l.google.com:19302" }, { urls: "stun:stun1.l.google.com:19302" }] };
const RING_MS = 30000;
let typingChannel = null, typingTimeout = null, typingSendTimeout = null, callChannel = null;
const peerChannels = {}; let call = null, incoming = null, incomingTimer = null;

function callTopic(userId) { return "eesi-call-" + userId; }
function startCallListener() {
  stopCallListener(); if (!state.userId) return;
  callChannel = client.channel(callTopic(state.userId), { config: { broadcast: { self: false } } })
    .on("broadcast", { event: "call" }, ({ payload }) => onCallSignal(payload)).subscribe();
}
function stopCallListener() {
  if (callChannel) { client.removeChannel(callChannel); callChannel = null; }
  Object.keys(peerChannels).forEach(k => { client.removeChannel(peerChannels[k]); delete peerChannels[k]; });
}
function sendTo(peerId, payload) {
  if (!peerChannels[peerId]) peerChannels[peerId] = client.channel(callTopic(peerId), { config: { broadcast: { self: false } } });
  const ch = peerChannels[peerId];
  const doSend = () => ch.send({ type: "broadcast", event: "call", payload: { ...payload, from: state.userId, to: peerId } });
  if (ch.state === "joined") return doSend();
  return new Promise(resolve => {
    ch.subscribe(status => { if (status === "SUBSCRIBED" && ch.state === "joined") resolve(doSend()); });
  });
}
function plain(desc) { return { type: desc.type, sdp: desc.sdp }; }
function waitForIce(pc) {
  return new Promise(resolve => {
    if (pc.iceGatheringState === "complete") return resolve();
    const done = () => { if (pc.iceGatheringState === "complete") { pc.removeEventListener("icegatheringstatechange", done); resolve(); } };
    pc.addEventListener("icegatheringstatechange", done);
    setTimeout(resolve, 4000);
  });
}
function newCall(id, peerId, peerName, kind, role) {
  const pc = new RTCPeerConnection(RTC_CONFIG);
  const c = { id, peerId, peerName, kind, role, pc, stream: null, remote: null, status: "setup", timer: null, clock: null };
  pc.ontrack = e => { c.remote = e.streams[0] || new MediaStream([e.track]); if (call === c) attachRemote(); };
  pc.onicecandidate = e => { if (e.candidate && call === c) sendTo(c.peerId, { type: "ice", callId: c.id, candidate: e.candidate.toJSON() }); };
  pc.onconnectionstatechange = () => {
    if (call !== c) return;
