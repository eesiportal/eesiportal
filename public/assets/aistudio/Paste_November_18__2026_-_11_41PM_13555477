        <div class="stat clickable manager-only hidden" onclick="go('members')"><strong id="memberCount">0</strong><span>👥 Members</span></div>
        <div class="stat clickable" onclick="go('online')"><strong id="onlineCount">0</strong><span>🟢 Online / Offline</span></div>
